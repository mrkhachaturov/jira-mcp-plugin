root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.java]
# Java line length is handled by google-java-format
max_line_length = off

[*.md]
# Markdown is rumdl's; nested lists legitimately indent by three.
indent_size = unset
max_line_length = off

# Wrapped attributes cannot land on a fixed multiple, so indentation is left to
# the author here; charset, line endings and trailing whitespace still apply.
[*.{xml,vm}]
indent_size = unset
max_line_length = off

# Machine-written: mise.lock is regenerated by mise, and the dev host under
# dev-tools/basic-host is vendored upstream.
[{mise.lock,justfile}]
max_line_length = off

[dev-tools/basic-host/**]
indent_size = unset
max_line_length = off
