root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.java]
# Java line length is handled by google-java-format
max_line_length = off

[*.md]
# Markdown line length is handled by rumdl
max_line_length = off

# Maven and the Atlassian plugin descriptor are 4-space by convention, and the
# admin template follows the descriptor it renders.
[*.{xml,vm}]
indent_size = 4
max_line_length = off

# Machine-written: mise.lock is regenerated by mise, and the dev host under
# dev-tools/basic-host is vendored upstream.
[{mise.lock,justfile}]
max_line_length = off

[dev-tools/basic-host/**]
indent_size = unset
max_line_length = off
